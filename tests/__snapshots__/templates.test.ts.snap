      <img alt="" data-pannable="emp-fixture-1" class="upload-hover-img" src="https://example.test/photo.png" crossorigin="anonymous" draggable="false" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1) translate(0px, 0px); z-index: 1;" onload="
        try {
          const canvas = document.createElement('canvas');
          canvas.width = 100;
          canvas.height = 100;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(this, 0, 0, 100, 100);
          const data = ctx.getImageData(0, 0, 100, 30).data;
          let r=0, g=0, b=0;
          for(let i=0; i<data.length; i+=4) {
            r += data[i]; g += data[i+1]; b += data[i+2];
          }
          const pixels = data.length / 4;
          const brightness = ((r/pixels) * 299 + (g/pixels) * 587 + (b/pixels) * 114) / 1000;
          const logo = this.parentElement.querySelector('svg');
          if(logo) logo.style.fill = brightness /> 140 ? '#1a1a1a' : '#ffffff';
        } catch(e) { console.error('Could not detect brightness', e); }
      " />

